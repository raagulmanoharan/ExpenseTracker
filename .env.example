# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — finance-optimized embeddings for spending narratives
# Get from: https://dash.voyageai.com — 50M free tokens
# Optional: without this, narrative search falls back to date-based retrieval
VOYAGE_API_KEY=pa-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Twilio — Account SID and Auth Token (from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# YOUR WhatsApp number (to receive nudges and alerts)
YOUR_WHATSAPP_NUMBER=whatsapp:+919XXXXXXXXX

# Webhook URL (for Twilio signature validation — your Render URL)
WEBHOOK_URL=https://your-app.onrender.com

# Port (Render sets this automatically)
PORT=3000

# Twilio Content Template SIDs (for production WhatsApp outside 24h session window)
# Create these in Twilio Console → Content Editor, then get approval from Meta.
# Without these, nudges will only send to users who messaged within the last 24h.
