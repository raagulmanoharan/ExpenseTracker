# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets ID
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account JSON (paste full contents of raagbot-key.json)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Twilio — Account SID and Auth Token (from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# YOUR WhatsApp number (to receive nudges and alerts)
YOUR_WHATSAPP_NUMBER=whatsapp:+919XXXXXXXXX

# Webhook URL (for Twilio signature validation — your Render URL)
WEBHOOK_URL=https://your-app.onrender.com

# Port (Render sets this automatically)
PORT=3000

# Twilio Content Template SIDs (for production WhatsApp outside 24h session window)
# Create these in Twilio Console → Content Editor, then get approval from Meta.
# Without these, nudges will only send to users who messaged within the last 24h.
TEMPLATE_SID_SMART_NUDGE=HX40b5d6ddf91f82bfc1e475aae833a5e2
TEMPLATE_SID_MORNING_FOLLOWUP=HX2878d391fcac79f1ace0a6c7e2d74bc7
TEMPLATE_SID_PRE_STATEMENT=HX2cc457c2c453809cd5e153ac3b277589
TEMPLATE_SID_LAPSE_NUDGE=HXa581bf277b34f13d72c13c8adcd1dda5
TEMPLATE_SID_DAILY_NUDGE=HX8ff2112fec3c305f997a6b15838f03a1
TEMPLATE_SID_FRIDAY_CHART=HXb753888c2be94ff7ee77ca94a5692c0c
TEMPLATE_SID_FRIDAY_DIGEST=HX4364034d29e502e48ea83f22346bf39e
TEMPLATE_SID_OVERSPEND_ALERT=HX31652da59db4ecc62311f43468fd8259
TEMPLATE_SID_EVENING_CHECKIN=HX434107808992af3dd3c4a3032e4e0186
